# Server-side AI keys. Optional: the user can also paste a key in Settings, which stays in
# their browser. Set these on the host (Vercel -> Settings -> Environment Variables) to give
# everyone a key without pasting anything.

# Which provider the "This app's server" option should use: gemini | openrouter | nvidia
STUDYFEED_AI_PROVIDER=gemini
# The key for that provider
STUDYFEED_AI_KEY=
# Optional override for the model id
STUDYFEED_AI_MODEL=

# Provider-specific alternatives (any one is enough; STUDYFEED_AI_KEY wins)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# The original Claude key, still accepted as a fallback
ANTHROPIC_API_KEY=
