{
  "name": "studyfeed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run data:index && vite dev --host 0.0.0.0 --port 5173",
    "build": "npm run data:index && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "data:index": "node scripts/build-index.mjs",
    "generate:cards": "tsx scripts/generate-cards.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-vercel": "^5.10.3",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@types/node": "^20.11.0",
    "@vite-pwa/sveltekit": "^0.6.0",
    "svelte": "^4.2.18",
    "svelte-check": "^3.8.0",
    "tslib": "^2.6.2",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-pwa": "^0.21.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-svelte": "^0.454.0"
  }
}
